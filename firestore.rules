rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email in [
          'm.riyasamir@gmail.com',
          'admin@swaraku.online'
        ];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isManualVoterId(uid) {
      return uid is string && uid.matches('^vreg_[a-zA-Z0-9_]+$');
    }

    // 3. Entity Validation Blueprints
    function isValidVoter(data) {
      return data.keys().hasAll(['uid', 'fullName', 'address', 'region', 'phone', 'email', 'points', 'referralCode', 'createdAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'address', 'region', 'phone', 'email', 'points', 'referralCode', 'referredBy', 'occupation', 'birthDate', 'lastEventRsvpId', 'authMethod', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.points is number && data.points >= 0 && data.points <= 1000000
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && (!('referredBy' in data) || (data.referredBy is string && data.referredBy.size() <= 32))
        && (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 100))
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 30))
        && (!('lastEventRsvpId' in data) || (data.lastEventRsvpId is string && data.lastEventRsvpId.size() <= 128))
        && (!('authMethod' in data) || (data.authMethod in ['google', 'manual']))
        && data.createdAt is timestamp;
    }

    function isValidVoterSignup(data) {
      return data.keys().hasAll(['voterId', 'email', 'phone', 'fullName', 'address', 'region', 'createdAt'])
        && data.keys().hasOnly(['voterId', 'email', 'phone', 'fullName', 'address', 'region', 'referralInput', 'linkedGoogleUid', 'createdAt'])
        && isManualVoterId(data.voterId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 120
        && (!('referralInput' in data) || (data.referralInput is string && data.referralInput.size() <= 32))
        && (!('linkedGoogleUid' in data) || (data.linkedGoogleUid is string && data.linkedGoogleUid.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'role', 'nama', 'username'])
        && data.keys().hasOnly([
          'id', 'role', 'nama', 'username', 'email', 'nik', 'jabatan', 'wilayah',
          'provinsi', 'kota', 'kecamatan', 'kelurahan', 'points',
          'idPegawai', 'divisi', 'tps', 'noHp', 'fotoUrl', 'password',
          'status', 'dibuatPada', 'updatedAt',
          'timSuksesId', 'timSuksesNama', 'didaftarkanOlehTimSukses',
          'korcamId', 'korcamNama',
          'kaderList', 'kaderIds',
          'latitude', 'longitude', 'accuracy', 'lastLocationUpdate', 'gpsState'
        ])
        && data.id is string && isValidId(data.id)
        && data.role in ['super_admin', 'admin', 'tim_sukses', 'kader', 'relawan']
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('nik' in data) || (data.nik is string && data.nik.size() <= 32))
        && (!('jabatan' in data) || (data.jabatan is string && data.jabatan.size() <= 160))
        && (!('wilayah' in data) || (data.wilayah is string && data.wilayah.size() <= 160))
        && (!('provinsi' in data) || (data.provinsi is string && data.provinsi.size() <= 120))
        && (!('kota' in data) || (data.kota is string && data.kota.size() <= 120))
        && (!('kecamatan' in data) || (data.kecamatan is string && data.kecamatan.size() <= 120))
        && (!('kelurahan' in data) || (data.kelurahan is string && data.kelurahan.size() <= 120))
        && (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 1000000))
        && (!('idPegawai' in data) || (data.idPegawai is string && data.idPegawai.size() <= 60))
        && (!('divisi' in data) || (data.divisi is string && data.divisi.size() <= 120))
        && (!('tps' in data) || (data.tps is string && data.tps.size() <= 60))
        && (!('noHp' in data) || (data.noHp is string && data.noHp.size() <= 30))
        && (!('fotoUrl' in data) || (data.fotoUrl is string && data.fotoUrl.size() <= 350000))
        && (!('password' in data) || (data.password is string && data.password.size() <= 120))
        && (!('status' in data) || (data.status in ['Aktif', 'Nonaktif']))
        && (!('dibuatPada' in data) || (data.dibuatPada is string && data.dibuatPada.size() <= 80))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 80))
        && (!('timSuksesId' in data) || (data.timSuksesId is string && data.timSuksesId.size() <= 128))
        && (!('timSuksesNama' in data) || (data.timSuksesNama is string && data.timSuksesNama.size() <= 120))
        && (!('didaftarkanOlehTimSukses' in data) || (data.didaftarkanOlehTimSukses is string && data.didaftarkanOlehTimSukses.size() <= 120))
        && (!('korcamId' in data) || (data.korcamId is string && data.korcamId.size() <= 128))
        && (!('korcamNama' in data) || (data.korcamNama is string && data.korcamNama.size() <= 120))
        && (!('kaderList' in data) || (data.kaderList is list && data.kaderList.size() <= 200 && (data.kaderList.size() == 0 || data.kaderList[0] is string)))
        && (!('kaderIds' in data) || (data.kaderIds is list && data.kaderIds.size() <= 200 && (data.kaderIds.size() == 0 || data.kaderIds[0] is string)))
        && (!('latitude' in data) || data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (!('accuracy' in data) || data.accuracy == null || (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000))
        && (!('lastLocationUpdate' in data) || data.lastLocationUpdate == null || data.lastLocationUpdate is timestamp || (data.lastLocationUpdate is string && data.lastLocationUpdate.size() <= 80))
        && (!('gpsState' in data) || data.gpsState == null || data.gpsState in ['online', 'background', 'offline']);
    }

    function isValidReferralCode(data) {
      return data.keys().hasAll(['uid', 'referralCode', 'createdAt'])
        && data.keys().hasOnly(['uid', 'referralCode', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'activityType', 'deviceInfo', 'timestamp'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'activityType', 'deviceInfo', 'timestamp'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.activityType in ['LOGIN', 'REGISTER & LOGIN']
        && data.deviceInfo is string && data.deviceInfo.size() >= 1 && data.deviceInfo.size() <= 300
        && data.timestamp is timestamp;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'partyName', 'region', 'eventDate', 'pointReward', 'address', 'lat', 'lng', 'rsvpYes', 'rsvpNo', 'createdAt'])
        && data.keys().hasOnly([
          'title', 'partyName', 'region', 'kota', 'kecamatan', 'kelurahan',
          'eventDate', 'description', 'eventStatus', 'pointReward',
          'address', 'lat', 'lng', 'rsvpYes', 'rsvpNo',
          'createdByName', 'createdByRole', 'createdAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 120
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 160
        && (!('kota' in data) || (data.kota is string && data.kota.size() <= 120))
        && (!('kecamatan' in data) || (data.kecamatan is string && data.kecamatan.size() <= 120))
        && (!('kelurahan' in data) || (data.kelurahan is string && data.kelurahan.size() <= 120))
        && data.eventDate is string && data.eventDate.size() >= 4 && data.eventDate.size() <= 60
        && (!('description' in data) || (data.description is string && data.description.size() <= 1200))
        && (!('eventStatus' in data) || (data.eventStatus in ['Akan Datang', 'Berlangsung', 'Selesai']))
        && data.pointReward is number && data.pointReward >= 0 && data.pointReward <= 10000
        && data.address is string && data.address.size() >= 4 && data.address.size() <= 300
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.rsvpYes is list && data.rsvpYes.size() <= 5000 && (data.rsvpYes.size() == 0 || data.rsvpYes[0] is string)
        && data.rsvpNo is list && data.rsvpNo.size() <= 5000 && (data.rsvpNo.size() == 0 || data.rsvpNo[0] is string)
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 120))
        && (!('createdByRole' in data) || (data.createdByRole is string && data.createdByRole.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidReward(data) {
      return data.keys().hasAll(['itemName', 'pointCost', 'stock', 'description', 'createdAt'])
        && data.keys().hasOnly(['itemName', 'pointCost', 'stock', 'description', 'imageUrl', 'iconKey', 'createdAt'])
        && data.itemName is string && data.itemName.size() >= 2 && data.itemName.size() <= 140
        && data.pointCost is number && data.pointCost >= 1 && data.pointCost <= 1000000
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.description is string && data.description.size() <= 500
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000))
        && (!('iconKey' in data) || (data.iconKey is string && data.iconKey.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidRewardClaim(data) {
      return data.keys().hasAll(['uid', 'voterName', 'phone', 'rewardId', 'itemName', 'pointUsed', 'status', 'claimedAt'])
        && data.keys().hasOnly([
          'uid', 'voterName', 'phone', 'rewardId', 'itemName', 'pointUsed', 'status',
          'accountType', 'userRole', 'wilayah', 'processedBy', 'note', 'claimedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.voterName is string && data.voterName.size() >= 2 && data.voterName.size() <= 120
        && data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30
        && data.rewardId is string && isValidId(data.rewardId)
        && data.itemName is string && data.itemName.size() >= 2 && data.itemName.size() <= 140
        && data.pointUsed is number && data.pointUsed >= 1 && data.pointUsed <= 1000000
        && data.status in ['MENUNGGU', 'DISETUJUI', 'DITOLAK', 'SELESAI', 'DISERAHKAN']
        && (!('accountType' in data) || (data.accountType in ['relawan', 'voter']))
        && (!('userRole' in data) || (data.userRole is string && data.userRole.size() <= 40))
        && (!('wilayah' in data) || (data.wilayah is string && data.wilayah.size() <= 160))
        && (!('processedBy' in data) || (data.processedBy is string && data.processedBy.size() <= 120))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.claimedAt is timestamp;
    }

    function isValidAspiration(data) {
      return data.keys().hasAll(['uid', 'voterName', 'region', 'message', 'createdAt'])
        && data.keys().hasOnly(['uid', 'voterName', 'region', 'message', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.voterName is string && data.voterName.size() >= 2 && data.voterName.size() <= 120
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 120
        && data.message is string && data.message.size() >= 4 && data.message.size() <= 1500
        && data.createdAt is timestamp;
    }

    function isValidCalegInfo(data) {
      return data.keys().hasAll(['calegName', 'partyName', 'region', 'description', 'createdAt'])
        && data.keys().hasOnly(['calegName', 'partyName', 'region', 'description', 'createdAt'])
        && data.calegName is string && data.calegName.size() >= 2 && data.calegName.size() <= 120
        && data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 120
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 120
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 1500
        && data.createdAt is timestamp;
    }

    function isValidKaderLocation(data) {
      return data.keys().hasAll(['userId', 'namaKader', 'gpsStatus', 'lastUpdated'])
        && data.keys().hasOnly(['userId', 'namaKader', 'latitude', 'longitude', 'accuracy', 'address', 'gpsStatus', 'lastUpdated'])
        && data.userId is string && isValidId(data.userId)
        && data.namaKader is string && data.namaKader.size() >= 1 && data.namaKader.size() <= 120
        && data.gpsStatus in ['Aktif', 'Tidak Aktif', 'Ditolak']
        && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && (!('accuracy' in data) || (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.lastUpdated is timestamp;
    }

    function isValidLiveCoord(lat, lng) {
      return (lat == null && lng == null)
        || (
          lat is number && lng is number
          && lat >= -90 && lat <= 90
          && lng >= -180 && lng <= 180
        );
    }

    function isValidLiveLocation(data, userId) {
      return data.keys().hasAll(['userId', 'nama', 'role', 'gpsStatus', 'lastUpdated'])
        && data.keys().hasOnly([
          'userId', 'nama', 'role', 'timSuksesId', 'namaTimSukses',
          'korcamId', 'namaKorcam',
          'latitude', 'longitude', 'accuracy', 'address', 'gpsStatus', 'lastUpdated'
        ])
        && data.userId is string && isValidId(data.userId) && data.userId == userId
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.role in ['Korwil', 'Korcam', 'Relawan', 'Tim Sukses', 'Kader']
        && (!('timSuksesId' in data) || data.timSuksesId == null || (data.timSuksesId is string && data.timSuksesId.size() <= 128))
        && (!('namaTimSukses' in data) || data.namaTimSukses == null || (data.namaTimSukses is string && data.namaTimSukses.size() <= 120))
        && (!('korcamId' in data) || data.korcamId == null || (data.korcamId is string && data.korcamId.size() <= 128))
        && (!('namaKorcam' in data) || data.namaKorcam == null || (data.namaKorcam is string && data.namaKorcam.size() <= 120))
        && data.gpsStatus in ['Aktif', 'Tidak Aktif', 'Ditolak']
        && isValidLiveCoord(data.latitude, data.longitude)
        && (!('accuracy' in data) || data.accuracy == null || (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 300))
        && data.lastUpdated is timestamp;
    }

    // 4. Collection Match Blocks

    // STAFF ACCOUNTS (Kader, Tim Sukses, Admin, Super Admin - multi-device cloud login & management)
    match /user_accounts/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) && isValidUserAccount(incoming());
      allow update: if isValidId(userId) && isValidUserAccount(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(userId);
    }

    // KADER GPS LOCATIONS (Real-time last-known GPS position per Kader; 1 doc per Kader)
    match /kader_locations/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
        && isValidKaderLocation(incoming())
        && incoming().userId == userId
        && incoming().lastUpdated == request.time;
      allow update: if isValidId(userId)
        && isValidKaderLocation(incoming())
        && incoming().userId == userId
        && incoming().userId == existing().userId
        && incoming().lastUpdated == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'namaKader', 'latitude', 'longitude', 'accuracy', 'address', 'gpsStatus', 'lastUpdated'
        ]);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // LIVE LOCATIONS (Real-time GPS untuk Tim Sukses & Kader; Monitoring SuperAdmin, Admin, & Tim Sukses)
    match /live_locations/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId)
        && isValidLiveLocation(incoming(), userId)
        && incoming().lastUpdated == request.time;
      allow update: if isValidId(userId)
        && incoming().lastUpdated == request.time
        && (
          (
            isValidLiveLocation(incoming(), userId)
            && incoming().userId == existing().userId
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['gpsStatus', 'lastUpdated'])
            && incoming().gpsStatus == 'Tidak Aktif'
          )
        );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // DATA VOTERS OCR & PETA SUARA (Tim Kampanye & Admin)
    match /voter_ocr_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create, update: if isValidId(recordId) && incoming().keys().hasAll(['nik', 'nama']);
      allow delete: if isValidId(recordId);
    }

    match /tim_sukses_members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create, update: if isValidId(memberId) && incoming().keys().hasAll(['id', 'nama']);
      allow delete: if isValidId(memberId);
    }

    match /c1_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create, update: if isValidId(recordId) && incoming().keys().hasAll(['id', 'tps']);
      allow delete: if isValidId(recordId);
    }

    match /b1_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create, update: if isValidId(recordId) && incoming().keys().hasAll(['id', 'kecamatan']);
      allow delete: if isValidId(recordId);
    }

    // VOTERS (PII Isolated for Loyalty SSO & Manual Sign-Up: Owner & Superadmin only; legacy OCR records readable via query constraint)
    match /voters/{uid} {
      allow get: if isValidId(uid) && (
        isOwner(uid)
        || isSuperAdmin()
        || existing().statusRegistrasi == 'TERDAFTAR'
        || (isManualVoterId(uid) && existing().uid == uid)
      );
      allow list: if isSuperAdmin()
        || (isSignedIn() && existing().uid == request.auth.uid)
        || existing().statusRegistrasi == 'TERDAFTAR';

      allow create: if isValidId(uid)
        && isValidVoter(incoming())
        && incoming().points == 100
        && incoming().createdAt == request.time
        && (
          (isVerifiedUser() && request.auth.uid == uid && incoming().uid == request.auth.uid)
          || (isManualVoterId(uid) && incoming().uid == uid && incoming().authMethod == 'manual')
        );

      allow update: if isValidId(uid)
        && isValidVoter(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().email == existing().email
        && incoming().referralCode == existing().referralCode
        && (
          isSuperAdmin()
          || (
            (isVerifiedUser() && isOwner(uid) || (isManualVoterId(uid) && existing().authMethod == 'manual'))
            && incoming().points == existing().points
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'address', 'region', 'phone', 'occupation', 'birthDate'])
          )
          || (
            (isVerifiedUser() && isOwner(uid) || (isManualVoterId(uid) && existing().authMethod == 'manual'))
            && incoming().diff(existing()).affectedKeys().hasOnly(['points', 'lastEventRsvpId'])
            && isValidId(incoming().lastEventRsvpId)
            && exists(/databases/$(database)/documents/events/$(incoming().lastEventRsvpId))
            && !(uid in get(/databases/$(database)/documents/events/$(incoming().lastEventRsvpId)).data.rsvpYes)
            && (uid in getAfter(/databases/$(database)/documents/events/$(incoming().lastEventRsvpId)).data.rsvpYes)
            && incoming().points == existing().points + get(/databases/$(database)/documents/events/$(incoming().lastEventRsvpId)).data.pointReward
          )
          || (
            (isVerifiedUser() && isOwner(uid) || (isManualVoterId(uid) && existing().authMethod == 'manual'))
            && incoming().diff(existing()).affectedKeys().hasOnly(['points'])
            && incoming().points < existing().points
            && incoming().points >= 0
          )
          || (
            isVerifiedUser()
            && uid != request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['points'])
            && incoming().points == existing().points + 50
            && !exists(/databases/$(database)/documents/voters/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/voters/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/voters/$(request.auth.uid)).data.referredBy == existing().referralCode
          )
          || (
            !isSignedIn()
            && incoming().diff(existing()).affectedKeys().hasOnly(['points'])
            && incoming().points == existing().points + 50
            && exists(/databases/$(database)/documents/referral_codes/$(existing().referralCode))
          )
        );

      allow delete: if isSuperAdmin() && isValidId(uid);
    }

    // MANUAL VOTER SIGNUP LOOKUP (Get by hashed email key only, no public list)
    match /voter_signups/{emailKey} {
      allow get: if isValidId(emailKey);
      allow list: if isSuperAdmin();
      allow create: if isValidId(emailKey)
        && isValidVoterSignup(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSuperAdmin()
        || (
          isVerifiedUser()
          && incoming().email == existing().email
          && incoming().diff(existing()).affectedKeys().hasOnly(['linkedGoogleUid'])
          && incoming().linkedGoogleUid == request.auth.uid
        );
      allow delete: if isSuperAdmin() && isValidId(emailKey);
    }

    // REFERRAL CODES (Non-PII lookup)
    match /referral_codes/{code} {
      allow get: if isValidId(code);
      allow list: if isSuperAdmin();
      allow create: if isValidId(code)
        && isValidReferralCode(incoming())
        && incoming().referralCode == code
        && incoming().createdAt == request.time
        && (
          (isVerifiedUser() && incoming().uid == request.auth.uid)
          || isManualVoterId(incoming().uid)
        );
      allow update: if false;
      allow delete: if isSuperAdmin() && isValidId(code);
    }

    // ACTIVITY LOGS (Owner & Superadmin read, immutable audit trail)
    match /activity_logs/{logId} {
      allow get: if isValidId(logId) && (isSuperAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(logId)
        && isValidActivityLog(incoming())
        && incoming().timestamp == request.time
        && (
          (isVerifiedUser() && incoming().uid == request.auth.uid)
          || isManualVoterId(incoming().uid)
        );
      allow update, delete: if false;
    }

    // EVENTS (Public campaign schedule & map, Tim Support Panel Manajemen Kampanye CRUD, RSVP)
    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create: if isValidId(eventId)
        && isValidEvent(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(eventId)
        && isValidEvent(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(eventId);
    }

    // REWARDS CATALOG (Non-PII public catalog, Tim Support Panel Manajemen Kampanye CRUD)
    match /rewards/{rewardId} {
      allow get: if isValidId(rewardId);
      allow list: if true;
      allow create: if isValidId(rewardId)
        && isValidReward(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(rewardId)
        && isValidReward(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(rewardId);
    }

    // REWARD CLAIMS (Relawan, Voter, & Panel Manajemen Kampanye Korwil/Korcam/Admin/SuperAdmin)
    match /reward_claims/{claimId} {
      allow get: if isValidId(claimId);
      allow list: if true;
      allow create: if isValidId(claimId)
        && isValidRewardClaim(incoming())
        && incoming().status == 'MENUNGGU'
        && incoming().claimedAt == request.time
        && exists(/databases/$(database)/documents/rewards/$(incoming().rewardId))
        && incoming().pointUsed == get(/databases/$(database)/documents/rewards/$(incoming().rewardId)).data.pointCost
        && getAfter(/databases/$(database)/documents/rewards/$(incoming().rewardId)).data.stock == get(/databases/$(database)/documents/rewards/$(incoming().rewardId)).data.stock - 1
        && (
          (
            ((isVerifiedUser() && incoming().uid == request.auth.uid) || isManualVoterId(incoming().uid))
            && exists(/databases/$(database)/documents/voters/$(incoming().uid))
            && getAfter(/databases/$(database)/documents/voters/$(incoming().uid)).data.points == get(/databases/$(database)/documents/voters/$(incoming().uid)).data.points - incoming().pointUsed
          )
          || (
            isValidId(incoming().uid)
            && exists(/databases/$(database)/documents/user_accounts/$(incoming().uid))
            && getAfter(/databases/$(database)/documents/user_accounts/$(incoming().uid)).data.points == get(/databases/$(database)/documents/user_accounts/$(incoming().uid)).data.points - incoming().pointUsed
          )
        );
      allow update: if isValidId(claimId)
        && isValidRewardClaim(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'processedBy', 'note'])
        && incoming().uid == existing().uid
        && incoming().rewardId == existing().rewardId
        && incoming().pointUsed == existing().pointUsed
        && incoming().claimedAt == existing().claimedAt
        && (
          (existing().status == 'MENUNGGU' && incoming().status in ['DISETUJUI', 'DITOLAK', 'SELESAI', 'DISERAHKAN'])
          || (existing().status == 'DISETUJUI' && incoming().status in ['SELESAI', 'DISERAHKAN', 'DITOLAK'])
        );
      allow delete: if isSuperAdmin() && isValidId(claimId);
    }

    // ASPIRATIONS (Owner, SuperAdmin & Panel Manajemen Kampanye)
    match /aspirations/{aspirationId} {
      allow get: if isValidId(aspirationId);
      allow list: if true;
      allow create: if isValidId(aspirationId)
        && isValidAspiration(incoming())
        && incoming().createdAt == request.time
        && ((isVerifiedUser() && incoming().uid == request.auth.uid) || isManualVoterId(incoming().uid));
      allow update, delete: if isSuperAdmin() && isValidId(aspirationId);
    }

    // CALEG & PARTY INFO (Non-PII public campaign info, Tim Support Panel Manajemen Kampanye CRUD)
    match /caleg_info/{infoId} {
      allow get: if isValidId(infoId);
      allow list: if true;
      allow create: if isValidId(infoId)
        && isValidCalegInfo(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(infoId)
        && isValidCalegInfo(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(infoId);
    }
  }
}
