{
  "entities": {
    "Voter": {
      "title": "Voter",
      "description": "Data pemilih hasil pendaftaran kader atau sinkronisasi DPT KPU",
      "type": "object",
      "properties": {
        "nik": { "type": "string" },
        "nama": { "type": "string" },
        "tps": { "type": "string" },
        "kelurahan": { "type": "string" },
        "kecamatan": { "type": "string" },
        "kabupatenKota": { "type": "string" },
        "provinsi": { "type": "string" },
        "jenisKelamin": { "type": "string" },
        "noHp": { "type": "string" },
        "statusDpt": { "type": "string" },
        "statusPendukung": { "type": "string" },
        "waktuDaftar": { "type": "string" },
        "terdaftarOleh": { "type": "string" }
      },
      "required": ["nik", "nama", "tps"]
    },
    "FormC1": {
      "title": "FormC1",
      "description": "Formulir C1 Plano hasil scan OCR atau upload saksi TPS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tps": { "type": "string" },
        "kelurahan": { "type": "string" },
        "kecamatan": { "type": "string" },
        "saksiNama": { "type": "string" },
        "waktuUpload": { "type": "string" },
        "suaraPaslon1": { "type": "number" },
        "suaraPaslon2": { "type": "number" },
        "suaraPaslon3": { "type": "number" },
        "suaraTidakSah": { "type": "number" },
        "totalSuaraSah": { "type": "number" },
        "statusVerifikasi": { "type": "string" }
      },
      "required": ["id", "tps", "suaraPaslon1"]
    },
    "FormB1": {
      "title": "FormB1",
      "description": "Formulir Model B1-KWK rekapitulasi tingkat kecamatan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kecamatan": { "type": "string" },
        "kelurahan": { "type": "string" },
        "dapil": { "type": "string" },
        "koordinatorNama": { "type": "string" },
        "waktuUpload": { "type": "string" },
        "suaraPaslon1": { "type": "number" },
        "suaraPaslon2": { "type": "number" },
        "suaraPaslon3": { "type": "number" },
        "suaraTidakSah": { "type": "number" },
        "totalSuaraSah": { "type": "number" },
        "totalTpsTercakup": { "type": "number" },
        "statusVerifikasi": { "type": "string" }
      },
      "required": ["id", "kecamatan", "suaraPaslon1"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Akun login pengguna multi-perangkat (Super Admin, Admin, Tim Sukses, Kader)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "nama": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "jabatan": { "type": "string" },
        "wilayah": { "type": "string" },
        "tps": { "type": "string" },
        "noHp": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "dibuatPada": { "type": "string" },
        "fotoUrl": { "type": "string" }
      },
      "required": ["id", "role", "nama", "username"]
    },
    "TimSukses": {
      "title": "TimSukses",
      "description": "Data penugasan wilayah dan koordinat tim sukses di peta suara",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "noHp": { "type": "string" },
        "jabatan": { "type": "string" },
        "kota": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string" },
        "waktuDaftar": { "type": "string" }
      },
      "required": ["id", "nama", "kota"]
    }
  },
  "firestore": {
    "/voters/{voterId}": {
      "schema": { "$ref": "#/entities/Voter" },
      "description": "Daftar pemilih tetap dan rujukan kader"
    },
    "/c1_records/{c1Id}": {
      "schema": { "$ref": "#/entities/FormC1" },
      "description": "Dokumen C1 Plano tabulasi quick count"
    },
    "/b1_records/{b1Id}": {
      "schema": { "$ref": "#/entities/FormB1" },
      "description": "Dokumen B1 rekapitulasi kecamatan"
    },
    "/user_accounts/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Penyimpanan akun pengguna real-time multi-device"
    },
    "/tim_sukses_members/{tsId}": {
      "schema": { "$ref": "#/entities/TimSukses" },
      "description": "Struktur tim sukses dan titik koordinat peta suara"
    }
  }
}
