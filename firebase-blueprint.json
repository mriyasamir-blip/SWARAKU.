{
  "entities": {
    "Voter": {
      "title": "Voter",
      "description": "Profil dan saldo poin pemilih terdaftar melalui Google SSO",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "address": { "type": "string", "minLength": 5, "maxLength": 300 },
        "region": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "points": { "type": "number" },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "referredBy": { "type": "string", "maxLength": 32 },
        "occupation": { "type": "string", "maxLength": 100 },
        "birthDate": { "type": "string", "maxLength": 30 },
        "lastEventRsvpId": { "type": "string", "maxLength": 128 },
        "authMethod": { "type": "string", "enum": ["google", "manual"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "address", "region", "phone", "email", "points", "referralCode", "createdAt"]
    },
    "VoterSignupLookup": {
      "title": "VoterSignupLookup",
      "description": "Indeks pendaftaran manual pemilih berdasarkan email terenkode untuk login & penautan SSO Google",
      "type": "object",
      "properties": {
        "voterId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "fullName": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "region": { "type": "string", "maxLength": 120 },
        "referralInput": { "type": "string", "maxLength": 32 },
        "linkedGoogleUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["voterId", "email", "phone", "fullName", "address", "region", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Akun tim support & relawan multi-perangkat (SuperAdmin, Admin, Korwil, Korcam, Relawan)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "tim_sukses", "kader", "relawan"] },
        "nama": { "type": "string", "maxLength": 120 },
        "username": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 150 },
        "nik": { "type": "string", "maxLength": 32 },
        "jabatan": { "type": "string", "maxLength": 160 },
        "wilayah": { "type": "string", "maxLength": 160 },
        "kota": { "type": "string", "maxLength": 120 },
        "kecamatan": { "type": "string", "maxLength": 120 },
        "kelurahan": { "type": "string", "maxLength": 120 },
        "points": { "type": "number" },
        "idPegawai": { "type": "string", "maxLength": 60 },
        "divisi": { "type": "string", "maxLength": 120 },
        "tps": { "type": "string", "maxLength": 60 },
        "noHp": { "type": "string", "maxLength": 30 },
        "fotoUrl": { "type": "string", "maxLength": 350000 },
        "password": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif"] },
        "dibuatPada": { "type": "string", "maxLength": 80 },
        "updatedAt": { "type": "string", "maxLength": 80 },
        "timSuksesId": { "type": "string", "maxLength": 128 },
        "timSuksesNama": { "type": "string", "maxLength": 120 },
        "didaftarkanOlehTimSukses": { "type": "string", "maxLength": 120 },
        "korcamId": { "type": "string", "maxLength": 128 },
        "korcamNama": { "type": "string", "maxLength": 120 },
        "kaderList": { "type": "array" },
        "kaderIds": { "type": "array" }
      },
      "required": ["id", "role", "nama", "username"]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Peta kode undangan non-PII untuk validasi poin referral",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "referralCode", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Catatan aktivitas login dan registrasi multi-perangkat",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "activityType": { "type": "string", "enum": ["LOGIN", "REGISTER & LOGIN"] },
        "deviceInfo": { "type": "string", "maxLength": 300 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "activityType", "deviceInfo", "timestamp"]
    },
    "CampaignEvent": {
      "title": "CampaignEvent",
      "description": "Jadwal acara kampanye partai/Caleg beserta wilayah berjenjang dan koordinat peta Google Maps",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "region": { "type": "string", "minLength": 2, "maxLength": 160 },
        "kota": { "type": "string", "maxLength": 120 },
        "kecamatan": { "type": "string", "maxLength": 120 },
        "kelurahan": { "type": "string", "maxLength": 120 },
        "eventDate": { "type": "string", "minLength": 4, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 1200 },
        "eventStatus": { "type": "string", "enum": ["Akan Datang", "Berlangsung", "Selesai"] },
        "pointReward": { "type": "number" },
        "address": { "type": "string", "minLength": 4, "maxLength": 300 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "rsvpYes": { "type": "array" },
        "rsvpNo": { "type": "array" },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdByRole": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "partyName", "region", "eventDate", "pointReward", "address", "lat", "lng", "rsvpYes", "rsvpNo", "createdAt"]
    },
    "RewardItem": {
      "title": "RewardItem",
      "description": "Katalog barang/reward yang dapat ditukar dengan poin Relawan dan Pemilih",
      "type": "object",
      "properties": {
        "itemName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "pointCost": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "iconKey": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemName", "pointCost", "stock", "description", "createdAt"]
    },
    "RewardClaim": {
      "title": "RewardClaim",
      "description": "Riwayat klaim penukaran poin oleh Relawan dan Pemilih",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "voterName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "rewardId": { "type": "string", "maxLength": 128 },
        "itemName": { "type": "string", "maxLength": 140 },
        "pointUsed": { "type": "number" },
        "status": { "type": "string", "enum": ["MENUNGGU", "DISETUJUI", "DITOLAK", "SELESAI", "DISERAHKAN"] },
        "accountType": { "type": "string", "enum": ["relawan", "voter"] },
        "userRole": { "type": "string", "maxLength": 40 },
        "wilayah": { "type": "string", "maxLength": 160 },
        "processedBy": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 300 },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "voterName", "phone", "rewardId", "itemName", "pointUsed", "status", "claimedAt"]
    },
    "Aspiration": {
      "title": "Aspiration",
      "description": "Aspirasi dan masukan warga/pemilih berdasarkan dapil",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "voterName": { "type": "string", "maxLength": 120 },
        "region": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "minLength": 4, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "voterName", "region", "message", "createdAt"]
    },
    "CalegInfo": {
      "title": "CalegInfo",
      "description": "Informasi Partai Politik dan Profil Calon Legislatif per Dapil",
      "type": "object",
      "properties": {
        "calegName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "partyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "region": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "minLength": 4, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["calegName", "partyName", "region", "description", "createdAt"]
    },
    "KaderLocation": {
      "title": "KaderLocation",
      "description": "Posisi GPS real-time terakhir setiap akun Kader untuk halaman Monitoring Kader Admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "namaKader": { "type": "string", "minLength": 1, "maxLength": 120 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "address": { "type": "string", "maxLength": 300 },
        "gpsStatus": { "type": "string", "enum": ["Aktif", "Tidak Aktif", "Ditolak"] },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "namaKader", "gpsStatus", "lastUpdated"]
    },
    "LiveLocation": {
      "title": "LiveLocation",
      "description": "Posisi GPS real-time terakhir Korwil, Korcam, dan Relawan untuk menu Monitoring Relawan",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nama": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["Korwil", "Korcam", "Relawan", "Tim Sukses", "Kader"] },
        "timSuksesId": { "type": "string", "maxLength": 128 },
        "namaTimSukses": { "type": "string", "maxLength": 120 },
        "korcamId": { "type": "string", "maxLength": 128 },
        "namaKorcam": { "type": "string", "maxLength": 120 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "address": { "type": "string", "maxLength": 300 },
        "gpsStatus": { "type": "string", "enum": ["Aktif", "Tidak Aktif", "Ditolak"] },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "nama", "role", "gpsStatus", "lastUpdated"]
    }
  },
  "firestore": {
    "/voters/{uid}": {
      "schema": { "$ref": "#/entities/Voter" },
      "description": "Profil dan saldo poin pemilih"
    },
    "/voter_signups/{emailKey}": {
      "schema": { "$ref": "#/entities/VoterSignupLookup" },
      "description": "Lookup pendaftaran manual pemilih per email"
    },
    "/user_accounts/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Akun tim kampanye lintas perangkat (Super Admin, Admin, Tim Sukses, Kader)"
    },
    "/kader_locations/{userId}": {
      "schema": { "$ref": "#/entities/KaderLocation" },
      "description": "Tracking GPS real-time terakhir per akun Kader (1 dokumen per Kader)"
    },
    "/live_locations/{userId}": {
      "schema": { "$ref": "#/entities/LiveLocation" },
      "description": "Tracking GPS real-time Tim Sukses & Kader untuk Monitoring berbasis role"
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Lookup kode referral non-PII"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Buku aktivitas login dan registrasi"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampaignEvent" },
      "description": "Jadwal acara kampanye dan RSVP"
    },
    "/rewards/{rewardId}": {
      "schema": { "$ref": "#/entities/RewardItem" },
      "description": "Katalog reward penukaran poin"
    },
    "/reward_claims/{claimId}": {
      "schema": { "$ref": "#/entities/RewardClaim" },
      "description": "Catatan penukaran poin oleh pemilih"
    },
    "/aspirations/{aspirationId}": {
      "schema": { "$ref": "#/entities/Aspiration" },
      "description": "Aspirasi pemilih per dapil"
    },
    "/caleg_info/{infoId}": {
      "schema": { "$ref": "#/entities/CalegInfo" },
      "description": "Informasi partai dan Caleg per daerah/dapil"
    }
  }
}
